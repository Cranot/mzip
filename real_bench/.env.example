# Application Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
APP_NAME=myapp
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0
APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE=/var/log/myapp/app.log
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp?sslmode=disable
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=myapp
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSL_MODE=disable
DATABASE_MAX_CONNECTIONS=100
DATABASE_IDLE_TIMEOUT=10s
DATABASE_CONNECTION_TIMEOUT=5s

# Read Replica (optional)
DATABASE_REPLICA_URL=postgresql://postgres:password@replica.localhost:5432/myapp?sslmode=disable

# =============================================================================
# Cache Configuration
# =============================================================================
# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1s
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Cache TTL (in seconds)
CACHE_DEFAULT_TTL=3600
CACHE_SESSION_TTL=86400
CACHE_USER_TTL=600

# =============================================================================
# Authentication & Security
# =============================================================================
# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=myapp
JWT_AUDIENCE=myapp-users

# Session Configuration
SESSION_SECRET=your_session_secret_key_here
SESSION_NAME=myapp_session
SESSION_MAX_AGE=86400

# Password Hashing
BCRYPT_ROUNDS=12

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID
CORS_MAX_AGE=86400

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================================================
# External Services
# =============================================================================
# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=myapp-assets
AWS_S3_ENDPOINT=
AWS_CLOUDFRONT_URL=https://cdn.myapp.com

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# SendGrid Email
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@myapp.com
SENDGRID_FROM_NAME=MyApp

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_CHANNEL=#alerts

# =============================================================================
# Message Queue
# =============================================================================
# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=myapp
KAFKA_GROUP_ID=myapp-consumers
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_VHOST=/

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Tracing (Jaeger/OpenTelemetry)
TRACING_ENABLED=true
TRACING_EXPORTER=jaeger
JAEGER_ENDPOINT=http://localhost:14268/api/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry Error Tracking
SENTRY_DSN=https://xxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Datadog
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key
DD_ENV=development
DD_SERVICE=myapp

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_NEW_CHECKOUT=false
FEATURE_DARK_MODE=true
FEATURE_BETA_FEATURES=false
FEATURE_MAINTENANCE_MODE=false

# =============================================================================
# Third-Party Integrations
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Algolia Search
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_ADMIN_API_KEY=your_algolia_admin_key
ALGOLIA_SEARCH_API_KEY=your_algolia_search_key
ALGOLIA_INDEX_NAME=myapp_products

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# reCAPTCHA
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# =============================================================================
# Development Settings
# =============================================================================
# Hot Reload
HOT_RELOAD=true

# Debug
DEBUG=true
DEBUG_SQL=false
DEBUG_HTTP=false

# Seed Data
SEED_DATABASE=false
SEED_ADMIN_EMAIL=admin@myapp.com
SEED_ADMIN_PASSWORD=admin123

# =============================================================================
# Production Overrides (use in production .env)
# =============================================================================
# NODE_ENV=production
# LOG_LEVEL=warn
# DATABASE_SSL_MODE=require
# BCRYPT_ROUNDS=14
# DEBUG=false
# HOT_RELOAD=false
